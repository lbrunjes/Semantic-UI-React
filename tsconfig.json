{
  // Type checks the library's sources ("yarn typecheck"), see also:
  // - "tsconfig.build.json": emits the published typings to "dist/commonjs"
  // - "tsconfig.typings.json": checks the published typings like a consumer ("yarn tsd:test")
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": ["dom", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "include": ["src", "types"]
}
